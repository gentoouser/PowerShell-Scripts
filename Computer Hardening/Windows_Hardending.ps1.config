			<Value>bEnableGentech</Value>
			<Data>0</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide that's New screen as well as a See new features notication</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bWhatsNewExp</Value>
