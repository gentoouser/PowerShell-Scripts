<?xml version="1.0" encoding="utf-8"?>
<Config>
	<Company>
		<ReleaseNotes>
			<Note Version="1.0.0">First Release</Note>
			<Note Version="1.0.1">Updated Firewall Groups to Disable</Note>
			<Note Version="1.0.2">Disabled Saving of Passwords for users</Note>
			<Note Version="1.0.3">Fixed SChannel settings issues. Set UPNP Service to manual</Note>
			<Note Version="1.0.4">Detect Manager and Store Account Regex. Added AddressFilter to Firewall. Control ScheduledJob from Xml</Note>
			<Note Version="1.0.5">Enable IE Context Menu</Note>
			<Note Version="1.0.6">Disable Notification Center,Device Setup Manager Need for Printing,Updated other services,Block Signing in with Microsoft Account. Changed how File/folder Permission are set.</Note>
			<Note Version="1.0.7">Fixed issue with Windows 10 1809 and Start-menu. Added Options to update default User. Updated User Theme and Accent color settings. Set account and screen lockout.</Note>
			<Note Version="1.0.8">Blocking pwsh.exe. Updated UAC and SMB settings. Updated screensaver.</Note>
			<Note Version="1.0.9">Remove Pictures shortcut from Start Menu. Disable AutoSetup of printers.</Note>
			<Note Version="1.0.10">Added Fonts to install. Add full permission to c:\temp folder</Note>
			<Note Version="1.0.11">Enable NLA for RDP and Other RDP hardening. SMB Digitally sign communications. More hardening from STIG. Security Template INI Settings.</Note>
			<Note Version="1.0.12">VMwareOSOptimizationTool Tweaks. Edge Chromium and Chrome GPO Settings for stores</Note>
			<Note Version="1.0.13">WinHttpAutoProxySvc service changed to Auto for IE and Outlook fix,https://support.microsoft.com/en-us/help/4073119/protect-against-speculative-execution-side-channel-vulnerabilities-in fixes</Note>
			<Note Version="1.0.14">Turned On balloon notifications. Enabled different screensaver settings for VMs</Note>
			<Note Version="1.0.15">Microsoft Storage Spaces SMP Service changed to manual. Switched Certs to Folders, to allow for multiple certs. Updated MS Store WhiteList</Note>
			<Note Version="1.0.16">Set different Logon Cache count for Laptops. Set Windows Search to Automatic.</Note>
			<Note Version="1.0.17">Kerberos encryption types with RC4_HMAC_MD5 to fix Remote Assistance. Disable Updates Are Available Popup In Windows 10. Fixed Binary key issue.</Note>
			<Note Version="1.0.18">Added Fix for IPv6 ::1 issue. Trusted RDH Cert. Restrict OneDrive to Tenant</Note>
			<Note Version="1.0.19">Network Connectivity Status Indicator Fix</Note>
			<Note Version="1.0.20">Updated what settings are visible, Sysprep issues, Lockdown PowerShell 6 and 7 more</Note>
			<Note Version="1.0.21">Fixed issue stopping GPO/netlogon/sysvol access.</Note>
			<Note Version="1.0.22">Fix BITs and start-menu issues.</Note>
			<Note Version="1.0.23">Updated Windows 11 Whitelisted items</Note>
			<Note Version="1.0.24">Added login.microsoftonline.com to trusted zone</Note>
			<Note Version="1.0.25">Fixed issues with browser settings allowing saved passwords</Note>
			<Note Version="1.0.26">Revised Windows Services for Windows 11, Disabled browser notifications</Note>
			<Note Version="1.0.27">Whitelisted more Windows 11 Appx</Note>
			<Note Version="1.0.28">Added GPO Cipher Order Options in config. Fixed Hashe to Hash. Whitelisted more Windows 11 Appx</Note>
			<Note Version="1.0.29">Nessus Tweaks</Note>
			<Note Version="1.0.30">Fixed for Schannel</Note>
			<Note Version="1.0.31">Disable user from Change Language</Note>
			<Note Version="1.0.32">Enabled TLS 1.3 by default. Added CipherOrderGPOTLS1 to fixed for Schannel when AllowClientTLS1 is enabled.</Note>
			<Note Version="1.0.33">Update Adobe Acrobat settings and flow</Note>
			<Note Version="1.0.34">Firewall WMI fix</Note>
			<Note Version="1.0.35">Disable snipping tool</Note>
			<Note Version="1.0.36">Adobe Acrobat EULA</Note>
			<Note Version="1.1.0">CIA Hardening Settings</Note>
			<Note Version="1.1.1">Windows 11 24H2 Appx Changes</Note>
			<Note Version="1.1.2">Fixed services for Wi-fi</Note>
			<Note Version="1.1.3">Fixed Bug with EventLog</Note>
			<Note Version="1.1.4">Removed disabling Windows Defender</Note>
		</ReleaseNotes>
		<Version>1.1.4</Version>
		<LocalCache>c:\IT_Updates</LocalCache>
		<IconPath>C:\Program Files (x86)\Github\Icons</IconPath>
		<ScriptKey>Github</ScriptKey>
		<ScriptVersionValue>Security Hardening Version</ScriptVersionValue>
		<ScriptXMLVersionValue>Security Hardening XML Version</ScriptXMLVersionValue>
		<ScriptDateValue>Security Hardening Date</ScriptDateValue>
		<SNMP>GithubGithub1</SNMP>
		<UserBaseName>Window</UserBaseName>
		<UserRangeStart>1</UserRangeStart>
		<UserRangeEnd>20</UserRangeEnd>
		<HomePage>http://Github.com</HomePage>
		<SoftwarePath>C:\Program Files (x86)\Github\Custom</SoftwarePath>
		<ExccutableName>gitnubcustom.exe</ExccutableName>
		<OEMInfoAddSerial>true</OEMInfoAddSerial>
		 <OEMLogo>LOGO_OEM.bmp</OEMLogo> <!-- Relative to WallPaper Folder -->
		<!-- Relative to Cache Folder Below -->
		<WallPaperFolder>Wallpapers</WallPaperFolder>
		<BackgroundFolder>Store workstations</BackgroundFolder>
		<UserPictures>Wallpapers\User Account Pictures</UserPictures>
		<CopyIconsLocalFolder>Icons</CopyIconsLocalFolder>
		<CertRootFolder>Root Certs</CertRootFolder>
		<CertIntermediateFolder>Intermediate Certs</CertIntermediateFolder>
		<CertTrustedPublishersFolder>Trusted Publishers Certs</CertTrustedPublishersFolder>
		<CopyAllUserDesktopFolder>Desktop</CopyAllUserDesktopFolder>
		<ManagerComputernameRegEx></ManagerComputernameRegEx>
		<StoreComputernameRegEx></StoreComputernameRegEx>
	</Company>
	<Permissions>
		<Registry>
			<Item Default="false" Store="false" LockedDown="false" Manager="false" MinimumVersion="5">
				<Hive>HKEY_LOCAL_MACHINE</Hive>
				<Key>SOFTWARE\WOW6432Node\Github\Custom</Key>
				<User>Users</User>
				<Permission>FullControl</Permission>
				<Action>Allow</Action>
			</Item>
		</Registry>
		<FileSystem>
			<Deny>
				<!-- <Comment>#Administrative Tools</Comment> -->
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\Administrative Tools</Item>
				<!-- <Comment>#Server Manager</Comment> -->
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\Server Manager.lnk</Item>
				<!-- <Comment>#System Tools</Comment> -->
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\System Tools</Item>
				<!-- <Comment>#RDP Client	</Comment> -->
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\Accessories\Remote Desktop Connection.lnk</Item>
				<!-- <Comment>#.Net</Comment> -->
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\Microsoft .NET Compact Framework 1.0 SP3 Installer.lnk</Item>
				<!-- <Comment>#HP</Comment> -->
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\HP</Item>
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\StarMicronics</Item>
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\MagTek</Item>
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\MiracastView.lnk</Item>
				<!-- Disable Updates Are Available Popup In Windows 10 -->
				<!-- <Item Default="true" Store="true" LockedDown="true" Manager="true" MinimumVersion="5">$env:system32\musnotification.exe</Item> -->
				<!-- <Item Default="true" Store="true" LockedDown="true" Manager="true" MinimumVersion="5">$env:system32\musnotificationux.exe</Item> -->
				<!-- Disable PowerShell 6 and 7 -->
				<Item Default="true" Store="true" LockedDown="true" Manager="true" MinimumVersion="5">$env:programdata\Microsoft\Windows\Start Menu\Programs\PowerShell</Item>
			</Deny>
			<DenyUser>
				<!-- <Comment>#PowerShell</Comment> -->
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Windows PowerShell</Item>
				<!-- <Comment>#System Tools</Comment> -->
				<Item Default="false" Store="true" LockedDown="false" Manager="false" MinimumVersion="5">\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\System Tools</Item>
			</DenyUser>
			<AllowFolder>
				<Item Default="false" Store="false" LockedDown="false" Manager="false" MinimumVersion="5">C:\StaffingModel</Item>
				<Item Default="false" Store="false" LockedDown="false" Manager="false" MinimumVersion="5">C:\Program Files (x86)\Github\Custom</Item>
				<Item Default="false" Store="false" LockedDown="false" Manager="false" MinimumVersion="5">C:\Program Files (x86)\Github</Item>
				<Item Default="false" Store="false" LockedDown="false" Manager="false" MinimumVersion="5">c:\temp</Item>
				<Item Default="false" Store="false" LockedDown="false" Manager="false" MinimumVersion="5">C:\Windows\Panther</Item>
			</AllowFolder>
		</FileSystem>
	</Permissions>
	<RoboCopyOptions>
		<Option>/R:3</Option>
		<Option>/W:3</Option>
		<Option>/NDL</Option>
		<Option>/NFL</Option>
		<Option>/NJH</Option>
		<Option>/XD Logs</Option>
	</RoboCopyOptions>
	<IE>
		<AddIEtoAllUserDesktop>true</AddIEtoAllUserDesktop>
		<Header></Header>
		<Footer></Footer>
		<Margin_Top>0.500000</Margin_Top>
		<Margin_Bottom>0.500000</Margin_Bottom>
		<Margin_Left>0.166000</Margin_Left>
		<Margin_Right>0.166000</Margin_Right>
		<Cache_Size>1024</Cache_Size>
		<Cache_Persistent>0</Cache_Persistent>
		<EnableUserChangingProxySettings>0</EnableUserChangingProxySettings>
		<AutoDetect>0</AutoDetect>
		<ProxyEnable>0</ProxyEnable>
		<EnableAutoProxyResultCache>0</EnableAutoProxyResultCache>
		<AutoConfigProxy>1</AutoConfigProxy>
		<DisableCachingOfSSLPages>1</DisableCachingOfSSLPages>
		<PopupsUseNewWindow>0</PopupsUseNewWindow>
		<PhishingFilter>1</PhishingFilter>
		<AutoImageResize>yes</AutoImageResize>
		<ZoneMaps>
		<!-- Zone    IE Zone Name
			0        My Computer
			1        Local Intranet Zone
			2        Trusted sites Zone
			3        Internet Zone
			4        Restricted Sites Zone
		-->
			<ZoneMap>
				<Site>blank</Site>
				<Protocol>about</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>Github.com</Site>
				<Protocol>https</Protocol>
				<Zone>1</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>microsoft.com</Site>
				<Protocol>https</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>microsoft.com</Site>
				<Protocol>http</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>www.microsoft.com</Site>
				<Protocol>https</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>www.microsoft.com</Site>
				<Protocol>http</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>microsoft.com\download</Site>
				<Protocol>https</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>microsoft.com\download</Site>
				<Protocol>http</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>microsoftonline.com</Site>
				<Protocol>http</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
			<ZoneMap>
				<Site>login.microsoftonline.com</Site>
				<Protocol>http</Protocol>
				<Zone>2</Zone>
			</ZoneMap>
		</ZoneMaps>
	</IE>
	<Chrome>
		<BaseZip>Google_Profile_Base.zip</BaseZip>
		<DelegateWhiteList>
			<URL>*.github.com</URL>
			<URL>autologon.microsoftazuread-sso.com</URL>
			<URL>aadg.windows.net.nsatc.net</URL>
			<URL>secure.aadcdn.microsoftonline-p.com</URL>
		</DelegateWhiteList>
		<BlackListURLs>
			<URL>file://*</URL>
			<URL>chrome://settings/clearBrowserData</URL>
			<URL>chrome://settings/clearBrowserData-frame</URL>
			<URL>chrome://extensions</URL>
		</BlackListURLs>
		<DisablesExtensions>True</DisablesExtensions>
	</Chrome>
