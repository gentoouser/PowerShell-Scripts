	<AdobeAcrobat>
		<Product>Adobe Acrobat</Product>
		<Product>Acrobat Reader</Product>
		<Version>11.0</Version>
		<Version>2005</Version>
		<Version>2015</Version>
		<Version>DC</Version>
		<Item Default="false" Store="false" LockedDown="false" Manager="false" MinimumVersion="5">
			<Comment>Enable both updates to the product's web-plugin components as well as all services</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bUpdater</Value>
			<Data>1</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide Send Feedback icon</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bUsageMeasurement</Value>
