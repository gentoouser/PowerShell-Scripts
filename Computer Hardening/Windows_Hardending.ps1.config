	<WindowsSettings>
		<!-- Setting "Power Button"
		 0 - Do nothing.
		 1 - Sleep.
		 2 - Hibernate.
		 3 - Shut down.
		 4 - Turn off the display.  -->
		<PowerButtionAction>3</PowerButtionAction>
		<EnableRDP>true</EnableRDP>
		<RemoveOneDrive>true</RemoveOneDrive>
		<DisableWindowsUpdatePopup>true</DisableWindowsUpdatePopup>
		<CleanTempOnStart>true</CleanTempOnStart>
		<CachedLogonsCount>0</CachedLogonsCount>
		<LaptopCachedLogonsCount>10</LaptopCachedLogonsCount>
		<ScreenSave>
			<!-- Sets Logon ScreenSaver -->
			<Active>1</Active>
			<Secure>1</Secure>
			<TimeOut>900</TimeOut>
			<ScreenSaver>C:\Windows\system32\scrnsave.scr</ScreenSaver>
			<!-- 0:  The image is centered if TileWallpaper=0 or tiled if TileWallpaper=1 
				 2:  The image is stretched to fill the screen 
				 6:  The image is resized to fit the screen while maintaining the aspect ratio. (Windows 7 and later)	
				10:  The image is resized and cropped to fill the screen while maintaining the aspect ratio. (Windows 7 and later) -->
			<WallpaperStyle>6</WallpaperStyle>
		</ScreenSave>
