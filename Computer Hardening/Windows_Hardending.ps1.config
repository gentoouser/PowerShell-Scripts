				</Item> -->
				<!-- <Item Default="false" Store="false" LockedDown="true" Manager="false" MinimumVersion="5">
					<Comment>Disable VMware debug driver</Comment>
					<Key>SYSTEM\CurrentControlSet\services\vmdebug</Key>
					<Value>Start</Value>
					<Data>4</Data>
