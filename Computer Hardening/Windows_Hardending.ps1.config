			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Disabled collect usage data for some of Acrobat's dialogs</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bEnableADMAnalytics</Value>
			<Data>0</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Limit prompts to 1 per day and 3 per week</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bLimitPromptsFeatureKey</Value>
			<Data>1</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide the UI that helps users find and download additional apps.</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bToggleDCAppCenter</Value>
			<Data>1</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide "for purchase" tools when searching for tools in Reader.</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bShowRhpToolSearch</Value>
			<Data>0</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide prompt Acrobat subscribers using Reader to download Acrobat.</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bReaderRetentionExperiment</Value>
			<Data>0</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide prompt Acrobat trial users to complete the purchase.</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bEnableTrialistLaunchCard</Value>
			<Data>0</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide users messages which promote (Trials, Acrobat, PDF Pack etc.)</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bToggleSophiaWebInfra</Value>
			<Data>0</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide the Express Templates options in Acrobat's Create PDF UI.</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bMerchandizingEnabled</Value>
			<Data>0</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Disables messages which encourage the user to upgrade the product.</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bAcroSuppressUpsell</Value>
			<Data>1</Data>
			<Type>DWORD</Type>
		</Item>
		<Item>
			<Comment>Hide Reader users the online Create PDF service option.</Comment>
			<Key>FeatureLockDown</Key>
			<Value>bGlobalBarMenuFeatureKey</Value>
